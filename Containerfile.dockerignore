# Mirror of .containerignore. Podman reads that one; docker buildx (used by release.yml) reads
# <Containerfile name>.dockerignore, i.e. this file, and ignores .containerignore. Keep both in sync.
# Keep the build context minimal: only what `uv sync` and hatchling need
# (pyproject.toml, uv.lock, README.md, LICENSE, src/) should be sent.
.git
.github
.claude
.venv
.env
.env.*
.pytest_cache
.ruff_cache
.pyright
.mypy_cache
.cache
**/__pycache__
**/*.py[cod]
*.egg-info
build
dist
tests
docs
CLAUDE.md
README.es.md
Containerfile
.containerignore
.gitignore
.python-version
